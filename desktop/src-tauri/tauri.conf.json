{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MOSE",
  "version": "0.1.0",
  "identifier": "com.moy.mose",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "MOSE — Moy's Open Subtitle Editor",
        "width": 1280,
        "height": 800,
        "minWidth": 960,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "theme": "Dark",
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false,
    "fileAssociations": [
      {
        "ext": ["mosp"],
        "name": "MOSE Project",
        "description": "Moy's Open Subtitle Project",
        "role": "Editor"
      }
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico",
      "icons/icon.icns"
    ]
  }
}
