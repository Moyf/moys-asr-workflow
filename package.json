{
  "name": "moys-asr-workflow-dev",
  "version": "0.0.0",
  "packageManager": "pnpm@11.28.4",
  "private": true,
  "engines": {"node": "^22.23.4 || ^24.22.1 || >=26.12.1"},
  "description": "Dev-only browser regression tooling for MAW (Playwright). No production dependency.",
  "scripts": {
    "dev": "node scripts/dev-session.mjs editor",
    "dev:editor": "node scripts/dev-session.mjs editor",
    "dev:launcher": "node scripts/dev-session.mjs launcher",
    "devl": "node scripts/dev-session.mjs launcher",
    "launcher": "node scripts/dev-session.mjs launcher --once",
    "editor": "node scripts/dev-session.mjs editor --once",
    "test": "playwright test --config=tests/config/playwright.config.mjs --project=chromium",
    "test:headed": "playwright test --config=tests/config/playwright.config.mjs --project=chromium --headed",
    "typecheck": "tsc -p web/tsconfig.typecheck.json",
    "build": "node scripts/build-editor.mjs --write && node scripts/build-launcher.mjs --write",
    "postinstall": "pnpm run build",
    "build:editor": "node scripts/build-editor.mjs --write",
    "check:editor": "node scripts/build-editor.mjs --check",
    "watch:editor": "node scripts/build-editor.mjs --watch",
    "build:launcher": "node scripts/build-launcher.mjs --write",
    "check:launcher": "node scripts/build-launcher.mjs --check",
    "watch:launcher": "node scripts/build-launcher.mjs --watch",
    "test:unit": "node --test tests/*.mjs"
  },
  "devDependencies": {
    "@playwright/test": "1.62.0",
    "acorn": "^8.18.0",
    "acorn-walk": "^8.3.5",
    "diff": "^9.0.0",
    "esbuild": "0.28.2",
    "eslint-scope": "^9.1.2",
    "magic-string": "^1.4.1",
    "playwright": "1.62.0",
    "typescript": "^7.0.2"
  }
}
