.env
.venv/
__pycache__/
*.py[cod]
.pytest_cache/

# Local task output and previews; source fixtures and shared evidence stay tracked.
/.artifacts/

# Derived editor and waveform data. Keep the JSON project and the original media outside the repository when possible.
*.waveform.json
*.mopeaks
*.quapeaks
!tests/test_data/*.quapeaks
*.json.bak
*.edit.html
!blank-editor.html
*.ReaPeaks.maw

# Local media and subtitle outputs
/examples/
!/examples/
/examples/*
!/examples/preview.html
!/examples/serve_ograf_preview.py
*.mp4
*.mov
*.mkv
*.avi
*.wav
*.mp3
*.m4a
*.flac
*.srt
/.omo

# Dev-only browser test tooling (Playwright)
node_modules/
.astro/
website/dist/
playwright-report/
test-results/

# esbuild 产物是构建生成物，不进 Git：运行时入口（serve.py / maw_gui.py /
# edit.py --blank）会在缺失或过期时自动重建，发布打包前也显式构建。
# 新鲜度哈希记录在同目录 .meta.json（同为生成物）。
web/editor/boot/editor-bundle.js
web/editor/boot/editor-bundle.meta.json
web/launcher/boot/launcher-bundle.js
web/launcher/boot/launcher-bundle.meta.json

# Local Windows GUI packaging outputs. Keep generated executables local.
/build/
/dist/
/dist/MAW/MAW.exe
*.zip
*.exe
*.spec.bak
!MAW.spec
.playwright-mcp/

# Local post-processing configuration (may contain personal paths and settings).
maw-postprocess.json

# AppImage 构建产物（scripts/build-appimage.sh）
build-appimage/

# Local reference material. Never package or commit these files.
/ref/
/output/playwright/cue-scroll

# User-owned recognition presets.
/asr-presets/

# Agent worktrees
.worktrees/
.DS_Store

# Local diagnostic output (never source or test fixtures).
/.debug-runs/
/debug.log
