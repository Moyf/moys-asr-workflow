.env
.venv/
__pycache__/
*.py[cod]
.pytest_cache/

# Derived editor and waveform data. Keep the JSON project and the original media outside the repository when possible.
*.waveform.json
*.json.bak
*.edit.html
!blank-editor.html

# Local media and subtitle outputs
*.mp4
*.mov
*.mkv
*.avi
*.wav
*.mp3
*.m4a
*.flac
*.srt

# Uploaded media via Web Console
uploads/

# Console history
.console-history.json

# Local model weights (download manually, several GB each)
models/
!models/.gitkeep

# Reasonix agent context / configuration (local-only AI tooling)
.reasonix/

# Pip freeze 导出（依赖已在 pyproject.toml 中记录）
requirements.txt
requirements-local.txt
