# 复制本文件为 .env 并填入实际值（.env 已被 gitignore，不会提交）
# 用于 generate_subtitle_qwen_api.py（qwen3-asr-flash-filetrans 异步模式）
# API Key 申请：https://help.aliyun.com/zh/model-studio/get-api-key

DASHSCOPE_API_KEY=

# 地域：beijing（华北2，默认）或 singapore（新加坡）
DASHSCOPE_REGION=beijing

# 仅 DASHSCOPE_REGION=singapore 时需要：业务空间 ID
DASHSCOPE_WORKSPACE_ID=

# 可选：默认语言（不填则自动识别）。取值如 zh / yue / en / ja / ko / de / fr
DASHSCOPE_DEFAULT_LANGUAGE=

# 可选：GUI 界面语言（默认 zh，可选 zh / en）
MAW_GUI_LANG=zh

# 可选：GUI 记忆上次选择的模型与语言（空语言 = 自动识别）
MAW_GUI_LAST_MODEL=
MAW_GUI_LAST_LANGUAGE=

# 可选：GUI 是否显示相对小众的语言（默认 false，仅显示 8 种常用语言）
MAW_GUI_SHOW_RARE_LANGS=false

# 可选：是否启用字级时间戳（默认 true，字幕工具必须为 true）
DASHSCOPE_ENABLE_WORDS=true

# 可选：是否启用 ITN（默认 false）
DASHSCOPE_ENABLE_ITN=false

# 可选：轮询间隔（秒，默认 5）
DASHSCOPE_POLL_INTERVAL=5

# 可选：轮询超时（秒，默认 1800）
DASHSCOPE_POLL_TIMEOUT=1800

# 可选：FFmpeg 路径（可填 ffmpeg.exe，或 ffmpeg/ffprobe 所在 bin 目录）
FFMPEG_PATH=


# ===== Soniox STT（可选第二供应商，generate_subtitle_soniox_api.py 使用）=====
# API Key 申请：https://console.soniox.com
SONIOX_API_KEY=

# 可选：模型（默认 stt-async-v5）
SONIOX_MODEL=stt-async-v5

# 可选：轮询间隔（秒，默认 3）
SONIOX_POLL_INTERVAL=3

# 可选：轮询超时（秒，默认 1800）
SONIOX_POLL_TIMEOUT=1800


# ===== 表情包默认路径（HTML 编辑器使用）=====
# 未传 -s/--stickers 参数时，edit.py / generate_subtitle_*.py / regen_html.py 从此读取
# 支持嵌套子目录（如 大狗/、Nox/ 等子文件夹会被递归扫描）
STICKER_DIR=
