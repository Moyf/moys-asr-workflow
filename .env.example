# 复制本文件为 .env 并填入实际值（.env 已被 gitignore，不会提交）
# 用于 generate_subtitle_qwen_api.py（Qwen / Fun-ASR 异步文件转写）
# API Key 申请：https://help.aliyun.com/zh/model-studio/get-api-key

DASHSCOPE_API_KEY=

# 地域：beijing（华北2，默认）或 singapore（新加坡）
DASHSCOPE_REGION=beijing

# 业务空间 ID：北京地域选填（填写后使用推荐的专属域名），新加坡地域必填
DASHSCOPE_WORKSPACE_ID=

# 可选：默认语言（不填则自动识别）。不同模型支持范围不同，取值如 zh / en / ja / ko / de / fr
DASHSCOPE_DEFAULT_LANGUAGE=

# 可选：GUI 界面语言（默认 zh，可选 zh / en）
MAW_GUI_LANG=zh

# 可选：GUI 记忆上次选择的模型与语言（空语言 = 自动识别）
MAW_GUI_LAST_MODEL=
MAW_GUI_LAST_LANGUAGE=

# 可选：GUI 是否显示相对小众的语言（默认 false，仅显示 8 种常用语言）
MAW_GUI_SHOW_RARE_LANGS=false

# 可选：旧 Qwen3 是否启用字级时间戳（默认 true；Qwen-Audio/Fun-ASR 固定开启）
DASHSCOPE_ENABLE_WORDS=true

# 可选：Qwen 是否启用 ITN（默认 false；Fun-ASR 由模型固定处理）
DASHSCOPE_ENABLE_ITN=false

# ===== Qwen-Audio 3.0 ASR（可选） =====
# 预编译热词表 ID：必须在百炼按 qwen-audio-3.0-asr-flash-filetrans 创建
DASHSCOPE_QWEN_AUDIO_VOCABULARY_ID=

# hotwords.txt 的即时热词权重：1-5 或 50；默认 5。仅 Qwen-Audio 使用
DASHSCOPE_QWEN_AUDIO_HOTWORD_WEIGHT=5

# 可选：UTF-8 context 文件路径；每次最多发送 400 字符
DASHSCOPE_QWEN_AUDIO_CONTEXT_FILE=

# ===== Fun-ASR 热词（可选） =====
# 必须在百炼按 Fun-ASR 目标模型创建，不能复用 Qwen-Audio 的 vocabulary_id
DASHSCOPE_FUNASR_VOCABULARY_ID=

# 可选：轮询间隔（秒，默认 5）
DASHSCOPE_POLL_INTERVAL=5

# 可选：轮询超时（秒，默认 1800）
DASHSCOPE_POLL_TIMEOUT=1800

# 可选：FFmpeg 路径（可填 ffmpeg.exe，或 ffmpeg/ffprobe 所在 bin 目录）
FFMPEG_PATH=


# ===== Soniox STT（可选第二供应商，generate_subtitle_soniox_api.py 使用）=====
# API Key 申请：https://console.soniox.com
SONIOX_API_KEY=

# 可选：模型（默认 stt-async-v5）
SONIOX_MODEL=stt-async-v5

# 可选：轮询间隔（秒，默认 3）
SONIOX_POLL_INTERVAL=3

# 可选：轮询超时（秒，默认 1800）
SONIOX_POLL_TIMEOUT=1800


# ===== 必剪 ASR（实验性第三供应商，generate_subtitle_bcut_api.py 使用）=====
# 非官方免费接口，无需 API Key；可能随时变更、失效或触发限流，请勿高频调用
# 可选：单文件时长上限（秒，默认 7200；不建议上调）
BCUT_MAX_AUDIO_SECONDS=7200

# 可选：轮询间隔（秒，默认 3；硬下限 2，配低了会被抬回下限）
BCUT_POLL_INTERVAL=3

# 可选：轮询超时（秒，默认 1800）
BCUT_POLL_TIMEOUT=1800


# ===== 表情包默认路径（HTML 编辑器使用）=====
# 未传 -s/--stickers 参数时，edit.py / generate_subtitle_*.py / regen_html.py 从此读取
# 支持嵌套子目录（如 大狗/、Nox/ 等子文件夹会被递归扫描）
STICKER_DIR=
