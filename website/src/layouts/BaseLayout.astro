---
import '../styles/global.css';
import { sitePath } from '../lib/site-path';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "MAW — Moy's ASR Workflow",
  description = 'MAW（Moy\'s ASR Workflow）：把音视频转写、波形校对、文稿整理、可逆空隙移除与字幕交付接成一条本地优先的工作流，保留工程以便继续修改。',
} = Astro.props;
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#0d1319" />
    <link rel="icon" href={sitePath('favicon.ico')} />
    <title>{title}</title>
  </head>
  <body>
    <slot />
  </body>
</html>
