---
import BaseLayout from './BaseLayout.astro';
import { sitePath } from '../lib/site-path';
import { docsNavigation } from '../lib/docs-navigation';
import '../styles/docs.css';

const { frontmatter = {} } = Astro.props;
const title = frontmatter.title ?? Astro.props.title ?? 'MAW 文档';
const description = frontmatter.description ?? Astro.props.description ?? 'MAW 官方使用与工程文档。';
const source = frontmatter.source ?? Astro.props.source;
const currentPath = Astro.url.pathname;
const repoUrl = 'https://github.com/Moyf/moys-asr-workflow';

---

<BaseLayout title={`${title} — MAW 文档`} description={description}>
  <header class="docs-header">
    <div class="docs-topbar shell">
      <a class="docs-wordmark" href={sitePath('docs/')}>MAW / DOCS</a>
      <nav aria-label="文档导航">
        <a href={sitePath()}>返回首页</a>
        <a href={repoUrl}>GitHub ↗</a>
      </nav>
    </div>
  </header>

  <main class="docs-shell shell">
    <div class="docs-intro">
      <p class="docs-kicker">MAW documentation</p>
      <h1>{title}</h1>
      <p>{description}</p>
    </div>

    <div class="docs-layout">
      <aside class="docs-sidebar" aria-label="文档目录">
        <details class="docs-directory" data-docs-directory open>
          <summary class="docs-sidebar-label">文档目录</summary>
          <nav>
            {docsNavigation.map((group) => (
              <div class="docs-nav-group">
                <p class="docs-nav-group-label">{group.label}</p>
                {group.docs.map(([slug, label]) => (
                  <a href={sitePath(`docs/${slug}/`)} aria-current={currentPath === sitePath(`docs/${slug}/`) ? 'page' : undefined}>{label}</a>
                ))}
              </div>
            ))}
          </nav>
          {source && (
            <a class="docs-source" href={`${repoUrl}/blob/main/${source}`}>
              来源：{source}<br />在 GitHub 查看原文 ↗
            </a>
          )}
        </details>
      </aside>

      <article class="docs-content">
        {source && <p class="docs-source-note">本文同步自 MAW 原始仓库的 <a href={`${repoUrl}/blob/main/${source}`}>{source}</a>。</p>}
        <slot />
      </article>
    </div>
  </main>

  <footer class="docs-footer">
    <div class="shell">
      文档随 MAW 原始仓库维护 · <a href={repoUrl}>GitHub ↗</a>
    </div>
  </footer>
</BaseLayout>

<script>
  const directory = document.querySelector<HTMLDetailsElement>('[data-docs-directory]');
  if (directory) {
    const desktop = window.matchMedia('(min-width: 821px)');
    const setDefault = () => { directory.open = desktop.matches; };
    setDefault();
    desktop.addEventListener('change', setDefault);
  }
</script>
